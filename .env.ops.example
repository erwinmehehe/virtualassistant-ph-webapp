# One-time operational scripts only. Do not expose these as NEXT_PUBLIC variables.
# bootstrap:admin also needs NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.

# Optional: configure Supabase Auth SMTP via the Supabase Management API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
AUTH_EMAIL_FROM=no-reply@virtualassistant.com.ph
AUTH_EMAIL_SENDER_NAME=VirtualAssistant.com.ph
# Optional dedicated Resend key for Auth SMTP. If blank, configure-supabase-smtp uses RESEND_API_KEY.
AUTH_SMTP_PASSWORD=
