{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false,
      "feat/kiro-rendered-client-clean": true
    }
  },
  "redirects": [
    {
      "source": "/virtual-assistant-jobs",
      "destination": "https://virtualassistant.com.ph/jobs",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "https://virtualassistant.com.ph/jobs",
      "permanent": true
    },
    {
      "source": "/favicon.gif",
      "destination": "https://virtualassistant.com.ph/favicon.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "https://virtualassistant.com.ph/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon-120x120.png",
      "destination": "https://virtualassistant.com.ph/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon-120x120-precomposed.png",
      "destination": "https://virtualassistant.com.ph/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^www\\.virtualassistant\\.com\\.ph$"
        }
      ],
      "destination": "https://virtualassistant.com.ph/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\.virtualassistant\\.com\\.ph$"
        }
      ],
      "destination": "https://virtualassistant.com.ph/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 9 * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED": "true"
  }
}
