NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent key for signed public capability links. If unset, the server-only service-role key is used.
CAPABILITY_SIGNING_SECRET=

# App transactional email through the Resend API.
RESEND_API_KEY=
# Signing secret from the Resend webhook used for delivered/bounced status.
RESEND_WEBHOOK_SECRET=
# Set this only after the sender/domain is verified in Resend.
# Example: VirtualAssistant.com.ph <notifications@virtualassistant.com.ph>
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
APPLICATION_CC_EMAIL=jrvsaccad@gmail.com
# Optional reply-to mailbox for client-facing booking and hiring emails.
# Falls back to the first LEAD_NOTIFICATION_EMAIL when unset.
CLIENT_REPLY_TO_EMAIL=

# Required in production for automatic discovery-call and candidate-interview Google Meet links.
# Authorize the calendar owner with offline access and the Calendar scope.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional. Defaults to the authenticated user's primary calendar.
GOOGLE_CALENDAR_ID=primary

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-to-server /api/leads integration secret. Generate with: npm run secret:lead
LEAD_INGEST_SECRET=

# Optional AI Gateway job-description enrichment for public hiring briefs.
# Lead capture still succeeds and keeps the deterministic fallback draft when unset.
AI_GATEWAY_API_KEY=
# Defaults to openai/gpt-5.6-luna when unset.
AI_JOB_DRAFT_MODEL=
# Public talent semantic search uses Supabase Edge AI (gte-small) through the
# server-only talent-embeddings Edge Function. No separate embedding API key is required.

# Social login is provider-specific. Set a provider to "true" only after its
# OAuth client is registered and the matching Supabase Auth provider is enabled.
# Leaving a provider unset/false keeps its button hidden.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=

# Optional booking link for the floating discovery-call CTA (Calendly, Cal.com,
# etc). Falls back to /contact when unset.
NEXT_PUBLIC_DISCOVERY_CALL_URL=

# Hidden archive copy for outbound operational email. Recipients are added by BCC,
# so clients and Virtual Assistants do not see internal watcher addresses.
# Defaults to bryanbatarina@gmail.com in code. The older EMAIL_ARCHIVE_CC /
# EMAIL_ARCHIVE_BCC names remain supported as fallbacks.
EMAIL_ARCHIVE_TO=

# Optional free Cloudflare Turnstile bot protection.
# Configure both values together in production. Leave both blank to disable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
