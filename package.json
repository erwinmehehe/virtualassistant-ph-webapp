    "svix": "^1.99.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "playwright": "^1.63.0",
    "prettier": "3.9.7",
