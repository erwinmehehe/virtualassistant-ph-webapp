NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App transactional email through the Resend API.
RESEND_API_KEY=
# Set this only after the sender/domain is verified in Resend.
# Example: VirtualAssistant.com.ph <notifications@virtualassistant.com.ph>
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
APPLICATION_CC_EMAIL=jrvsaccad@gmail.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-to-server /api/leads integration secret. Generate with: npm run secret:lead
LEAD_INGEST_SECRET=

# Social login is provider-specific. Set a provider to "true" only after its
# OAuth client is registered and the matching Supabase Auth provider is enabled.
# Leaving a provider unset/false keeps its button hidden.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=

# Optional booking link for the floating discovery-call CTA (Calendly, Cal.com,
# etc). Falls back to /contact when unset.
NEXT_PUBLIC_DISCOVERY_CALL_URL=

# Added to the To line of every outgoing email so the team keeps a record.
# Comma-separated for more than one watcher. These addresses are direct
# recipients, so they appear on mail sent to VAs and clients as well.
# Defaults to bryanbatarina@gmail.com in code; set this to override or to add
# more watchers. The older EMAIL_ARCHIVE_CC / EMAIL_ARCHIVE_BCC names still
# work as fallbacks.
EMAIL_ARCHIVE_TO=
