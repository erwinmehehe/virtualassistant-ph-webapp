{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^www\\.virtualassistant\\.com\\.ph$"
        }
      ],
      "destination": "https://virtualassistant.com.ph/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\.virtualassistant\\.com\\.ph$"
        }
      ],
      "destination": "https://virtualassistant.com.ph/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 9 * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED": "true"
  }
}
